# ============================================================
# ALLO VIDANGE — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# ============================================================

# Base de données PostgreSQL
DATABASE_URL="postgresql://allovidange:VOTRE_MOT_DE_PASSE@localhost:5432/allovidange"

# Auth.js secret — générez avec: openssl rand -base64 32
AUTH_SECRET="REMPLACEZ_PAR_UNE_CLÉ_SECRÈTE_ALÉATOIRE_32_CHARS"

# URL de déploiement (sans slash final)
NEXTAUTH_URL="https://votre-domaine.tn"

# Nom de l'application (optionnel — pour les meta)
NEXT_PUBLIC_APP_NAME="ALLO VIDANGE"
